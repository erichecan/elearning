# ============================================================
# Audrey 2.0 后端环境变量模板
# 用法：cp .env.example .env，然后填入真实值
# ⚠️ .env 已被 .gitignore 排除，禁止提交真实密钥
# ============================================================

# ---------- 必需 ----------
# Neon Postgres 连接串（含密码，云端通常需 ?sslmode=require）
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# 后端管理接口鉴权 token（前端 admin 以 x-admin-token header 传入）
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ---------- 服务地址（可选，含默认值）----------
# 监听地址 / 端口
HOST="127.0.0.1"
PORT="3001"
# 后端对外可访问的基础地址（生成 TTS/符号静态资源 URL 用）
BACKEND_PUBLIC_BASE_URL="http://127.0.0.1:3001"
# 后端调用自身/外部 API 的基础地址
API_BASE_URL="http://127.0.0.1:3001"
# 前端访问后端的地址（与前端根目录 .env 的同名变量保持一致）
VITE_API_BASE_URL="http://localhost:3001"

# ---------- AI 内容生成（可选，按需启用对应功能）----------
# Gemini —— 词库/内容生成
GOOGLE_API_KEY=""
# 图片生成（flashcard/绘本插图），二选一或都填
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""
# 联网检索（Tavily）
TAVILY_API_KEY=""

# ---------- TTS（可选，含默认值）----------
EDGE_TTS_VOICE="en-US-JennyNeural"
EDGE_TTS_CACHE_VERSION="v2"

# ---------- ARASAAC 符号资源（可选，含默认值）----------
SYMBOL_PACK_VERSION="v1"
# 符号资源 CDN（不填则用本地 public/symbols 静态服务）
SYMBOL_CDN_BASE_URL=""

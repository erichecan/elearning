{
    "name": "flashcard-kids-backend",
    "version": "1.0.0",
    "description": "Backend API for FlashCard Kids Content Generation",
    "main": "src/index.ts",
    "scripts": {
        "start": "ts-node src/index.ts",
        "dev": "nodemon src/index.ts",
        "build": "tsc",
        "migrate:phase1": "ts-node scripts/migrate-phase1.ts",
        "seed:initial": "ts-node scripts/seed-initial-data.ts",
        "prepare:coreword-images": "ts-node scripts/prepare-coreword-image-keywords.ts",
        "seed:coreword-images": "ts-node scripts/seed-coreword-images.ts",
        "symbols:download:arasaac": "python3 scripts/download_arasaac_symbols.py",
        "symbols:index:arasaac": "python3 scripts/build_arasaac_index.py",
        "seed:symbol-assets:arasaac": "ts-node scripts/seed-symbol-assets-arasaac.ts",
        "bootstrap:coreword-symbol-mapping": "ts-node scripts/bootstrap-coreword-symbol-mapping.ts",
        "prepare:coreword-manual-mapping": "ts-node scripts/prepare-coreword-manual-mapping.ts",
        "apply:coreword-manual-mapping": "ts-node scripts/apply-coreword-manual-mapping.ts",
        "prepare:coreword-review-17": "ts-node scripts/prepare-coreword-review-17.ts",
        "build:symbol-pack": "ts-node scripts/build-symbol-pack.ts",
        "build:symbol-pack:core200": "ts-node scripts/build-symbol-pack.ts --pack core-200 --type core --apply-usage-pack",
        "build:symbol-pack:starter600": "ts-node scripts/build-symbol-pack.ts --pack starter-600 --limit 600"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@neondatabase/serverless": "^1.0.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "openai": "^4.24.1",
        "puppeteer": "^24.36.1",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "replicate": "^1.4.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
